# ==============================================================================
# HarmonyHub - Supabase Configuration Template
# ==============================================================================
# To connect your Supabase project:
# 1. Duplicate this file as '.env.local' (gitignored for security)
# 2. Retrieve your project credentials from:
#    https://supabase.com/dashboard -> Project -> Settings -> API
# 3. Replace the placeholder values below with your Project URL & Anon Public Key.
#
# NOTE: Never commit .env.local or secret service role keys to source control.
# ==============================================================================

# Project URL (Found under Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / Publishable Public Key (Found under Project Settings -> API -> Project API keys)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
